# Managed by Ansible — do not edit manually.
# pgBackRest configuration for stanza '{{ backup_stanza_name }}'

[global]
# Repository settings
repo1-type={{ backup_repo_type if backup_repo_type != 'rustfs' else 's3' }}
# A path *inside* the bucket, never the bucket name. It used to be set to
# rustfs_bucket_name, which put the bucket name in the object keys a second
# time — pgbackrest then listed
#   GET /supabase-backups/?prefix=supabase-backups/archive/main/
# and the store answered 404, so stanza-create never produced archive.info and
# every archive-push failed with "[103]: unable to find a valid repository".
repo1-path=/pgbackrest
{% if backup_repo_type == 'rustfs' %}
# Local RustFS (S3-compatible)
repo1-s3-bucket={{ rustfs_bucket_name }}
repo1-s3-endpoint=http://rustfs:{{ rustfs_api_port }}
repo1-s3-region=us-east-1
repo1-s3-key={{ backup_s3_key | default('rustfsadmin') if backup_creds_source | default('env') == 'env' else '${PGBACKREST_REPO1_S3_KEY}' }}
repo1-s3-key-secret={{ backup_s3_key_secret | default('rustfsadmin') if backup_creds_source | default('env') == 'env' else '${PGBACKREST_REPO1_S3_KEY_SECRET}' }}
repo1-s3-uri-style=path
repo1-s3-verify-tls=n
{% elif backup_repo_type == 's3' %}
# External S3-compatible
repo1-s3-bucket={{ backup_s3_bucket }}
repo1-s3-endpoint={{ backup_s3_endpoint }}
repo1-s3-region={{ backup_s3_region }}
repo1-s3-key={{ backup_s3_key if backup_creds_source | default('env') == 'env' else '${PGBACKREST_REPO1_S3_KEY}' }}
repo1-s3-key-secret={{ backup_s3_key_secret if backup_creds_source | default('env') == 'env' else '${PGBACKREST_REPO1_S3_KEY_SECRET}' }}
repo1-s3-uri-style={{ backup_s3_uri_style }}
{% if not backup_s3_verify_tls %}repo1-s3-verify-tls=n
{% endif %}
{% elif backup_repo_type == 'posix' %}
# Local filesystem
{% endif %}
{% if backup_encryption %}
# Encryption at rest
repo1-cipher-type={{ backup_cipher_type }}
repo1-cipher-pass={{ backup_cipher_pass if backup_creds_source | default('env') == 'env' else '${PGBACKREST_REPO1_CIPHER_PASS}' }}
{% endif %}

# Retention
repo1-retention-full={{ backup_retention_full }}
repo1-retention-diff={{ backup_retention_diff }}
repo1-retention-archive={{ backup_retention_archive }}
repo1-retention-archive-type={{ backup_retention_archive_type }}

# WAL archiving — synchronous on purpose.
#
# Async archiving makes pgbackrest fork a worker by re-executing itself, and
# the binary here is not directly executable: it is musl-linked, lifted out of
# an Alpine image, and reachable only through /usr/bin/pgbackrest, a wrapper
# that invokes the musl loader explicitly. The spawned worker bypasses that
# wrapper, so it never starts. The symptom is precise and was reproduced on
# every run:
#
#   ERROR: [082]: unable to push WAL file '0000...0001' to the archive
#                 asynchronously after 1m second(s)
#          HINT: check '/var/log/pgbackrest/main-archive-push-async.log'
#
# with that log file never created, the spool empty, and every segment stuck
# at .ready. Synchronous is pgBackRest's own default; it does the push in
# process, so there is no re-exec to fail. On a single node the cost is
# throughput under heavy write bursts, which is the right trade for archiving
# that actually happens.
archive-async=n

# Logging
log-level-console=info
log-level-file=detail
log-path={{ pgbackrest_log_path }}

# Lock path (avoid /tmp which may be tmpfs)
lock-path=/var/lib/pgbackrest/lock

[{{ backup_stanza_name }}]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-user=supabase_admin

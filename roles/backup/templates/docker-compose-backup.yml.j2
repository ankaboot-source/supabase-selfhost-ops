# Managed by Ansible — do not edit manually.
# Backup stack: optional RustFS + exporter. pgBackRest commands run inside supabase-db.
# Run from: {{ backup_compose_dir | default('/home/' ~ deploy_user ~ '/backup') }}

services:
{% if backup_repo_type == 'rustfs' %}
  rustfs:
    image: {{ rustfs_image }}
    container_name: supabase-rustfs{{ '-' + deploy_env if deploy_env != 'changeit' else '' }}
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    environment:
      RUSTFS_ACCESS_KEY: {{ backup_s3_key | default('rustfsadmin') }}
      RUSTFS_SECRET_KEY: {{ backup_s3_key_secret | default('rustfsadmin') }}
      RUSTFS_ADDRESS: 0.0.0.0:{{ rustfs_api_port }}
      RUSTFS_CONSOLE_ADDRESS: 0.0.0.0:{{ rustfs_console_port }}
      RUSTFS_CONSOLE_ENABLE: "true"
      RUSTFS_OBS_LOG_DIRECTORY: /app/logs
    volumes:
      - ./volumes/rustfs:/data:z
      - ./volumes/rustfs-logs:/app/logs:z
    ports:
      - 127.0.0.1:{{ rustfs_api_port }}:{{ rustfs_api_port }}
      - 127.0.0.1:{{ rustfs_console_port }}:{{ rustfs_console_port }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:{{ rustfs_api_port }}/health"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - default

  # One-shot bootstrap: create the pgBackRest bucket. RustFS does not
  # auto-create buckets on first write, so the bucket must exist before
  # stanza-create or pgbackrest fails with 039. The RustFS `rc` CLI (its
  # first-party, mc-compatible client) is the recommended way to do this.
  # Data/log dir ownership is handled by Ansible (RustFS runs as non-root
  # UID {{ rustfs_uid }}:{{ rustfs_gid }}), so this container is network-only.
  rustfs-init:
    image: {{ rustfs_init_image }}
    container_name: supabase-rustfs-init{{ '-' + deploy_env if deploy_env != 'changeit' else '' }}
    depends_on:
      rustfs:
        condition: service_healthy
    restart: on-failure
    entrypoint: >
      /bin/sh -c "
      sleep 3;
      rc alias set rustfs http://rustfs:{{ rustfs_api_port }} '{{ backup_s3_key | default('rustfsadmin') }}' '{{ backup_s3_key_secret | default('rustfsadmin') }}';
      rc mb rustfs/{{ rustfs_bucket_name }};
      exit 0;
      "
    networks:
      - default
{% endif %}
{% if backup_monitoring_enabled | default(false) %}

  pgbackrest-exporter:
    image: {{ pgbackrest_exporter_image }}
    container_name: supabase-pgbackrest-exporter{{ '-' + deploy_env if deploy_env != 'changeit' else '' }}
    restart: unless-stopped
    environment:
      TZ: {{ timezone | default('UTC') }}
      PGBACKREST_STANZA: {{ backup_stanza_name }}
    volumes:
      - ./pgbackrest.conf:/etc/pgbackrest/pgbackrest.conf:ro
      # Its own lock directory, not the db's. /var/lib/pgbackrest holds only
      # local lock state — the repository itself lives in RustFS over S3 — so
      # there is nothing here the two need to share. Sharing it meant this
      # container's entrypoint re-chowned the directory to the image's uid and
      # PostgreSQL could no longer create /var/lib/pgbackrest/lock/*.lock, which
      # broke every archive-push.
      - ./volumes/pgbackrest-exporter:/var/lib/pgbackrest:z
    ports:
      - 127.0.0.1:{{ pgbackrest_exporter_port }}:9854
    networks:
      - default
{% if monitor_stack_deployed | default(false) | bool %}
      # Prometheus could not reach this exporter at all. The port above is
      # published on 127.0.0.1, and Prometheus scrapes from inside a container,
      # where the host gateway is a different address entirely:
      #   dial tcp 172.17.0.1:9854: connect: connection refused
      # Every backup alert this repository ships was therefore evaluated
      # against a target that was permanently down. Joining the exporter to the
      # monitoring network gives Prometheus a route to it — and nothing else:
      # only this container is attached, so the monitoring stack gains no path
      # to RustFS or to the database, which stay on supabase-backup-net.
      - monitor
{% endif %}
{% endif %}

networks:
  default:
    external: true
    name: supabase-backup-net{{ '-' + deploy_env if deploy_env != 'changeit' else '' }}
{% if monitor_stack_deployed | default(false) | bool %}
  monitor:
    external: true
    name: supabase-monitor-net
{% endif %}

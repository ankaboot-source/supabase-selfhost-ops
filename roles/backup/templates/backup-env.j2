# Managed by Ansible — do not edit manually.
# Backup stack environment (plaintext credentials — see backup_creds_source warning)
# For production, use backup_creds_source: vault and Ansible Vault instead.

{% if backup_repo_type == 'rustfs' %}
# Local RustFS credentials
RUSTFS_ACCESS_KEY={{ backup_s3_key | default('rustfsadmin') }}
RUSTFS_SECRET_KEY={{ backup_s3_key_secret | default('rustfsadmin') }}
{% elif backup_repo_type == 's3' %}
# External S3 credentials
PGBACKREST_REPO1_S3_KEY={{ backup_s3_key }}
PGBACKREST_REPO1_S3_KEY_SECRET={{ backup_s3_key_secret }}
{% endif %}
{% if backup_encryption %}
# Encryption passphrase — STORE THIS OFF THE SERVER (password manager, etc.)
# If lost, the backup repo is unrecoverable.
PGBACKREST_REPO1_CIPHER_PASS={{ backup_cipher_pass }}
{% endif %}